# Default environment variables for dev/runtime wiring.
# Non-secret defaults are checked in. Override secrets in .env.dev.

NAMESPACE=oip
DEPLOY_ENV=preprod
RELEASE=oip-web-backend

CHART=./ops/helm
PORT_FORWARD_PID_FILE=.dev-port-forwards.pids

SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/oip_web_backend
DB_USER=oip_local
OIP_SECURITY_PERMIT_ALL=false
OIP_SECURITY_JWT_EXPIRATION_MS=3600000
